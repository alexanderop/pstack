{
  "name": "pstack-evals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm test:helpers && vitest run --project unit --project contracts",
    "test:unit": "vitest run --project unit",
    "check": "tsc --noEmit",
    "eval:codex": "PSTACK_LIVE_EVALS=1 vitest run --project live-codex",
    "eval:baseline": "PSTACK_LIVE_EVALS=1 vitest run --project acceptance",
    "eval:list": "PSTACK_LIVE_EVALS=1 vitest list --no-static-parse --project contracts --project live-codex --project acceptance --project realistic --project comparison --project vue-comparison",
    "eval:realistic": "PSTACK_LIVE_EVALS=1 vitest run --project realistic",
    "eval:compare": "PSTACK_LIVE_EVALS=1 vitest run --project comparison",
    "eval:report": "node evals/scripts/report.mjs",
    "eval:vue": "PSTACK_LIVE_EVALS=1 vitest run --project vue-comparison",
    "eval:vue:pack": "node evals/scripts/vue-review-packet.mjs",
    "eval:vue:recheck": "vitest run --project vue-replay",
    "test:helpers": "node --test skills/poteto-mode/scripts/check-plan.test.mjs skills/poteto-mode/scripts/worktree-audit.test.mjs"
  },
  "devDependencies": {
    "@pstack/agent-eval": "workspace:*",
    "@types/node": "24",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
